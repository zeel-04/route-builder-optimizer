# Copy to deploy/.secrets.production (gitignored) and fill in.
# Every KEY=value line is pushed to GitHub Actions secrets with `gh secret set`.
# No quotes, no spaces around "=".

# Docker Hub account with push access to sjenterprise/global
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Supabase Postgres — use the transaction pooler (port 6543)
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

NOMINATIM_URL=
NOMINATIM_USER_AGENT=
GEOCODER_CLASS=

# Authentik. Same values go into Amplify (plus OIDC_CLIENT_SECRET there).
SSO_ENABLED=true
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=

# --- Not GitHub secrets: used only to create the Amplify app ---
AMPLIFY_OIDC_CLIENT_SECRET=
AMPLIFY_GITHUB_PAT=
