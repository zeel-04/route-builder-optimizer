# Backend base URL, server-side only (never NEXT_PUBLIC_).
API_URL=http://localhost:8000/api

# OIDC single sign-on (Authentik). All server-side only — never NEXT_PUBLIC_.
# Off by default; set to "true" to replace the password form with the SSO card.
SSO_ENABLED=false
OIDC_DISCOVERY_URL=https://authentik.example.com/application/o/route/.well-known/openid-configuration
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
# This app's public origin. Builds the redirect and post-logout URIs registered with the IdP.
APP_URL=http://localhost:3000
