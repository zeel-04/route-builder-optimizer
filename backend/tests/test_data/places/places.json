    "query_params": {"address": "12 Main St"},
    "expected_status": 401,
    "expected_body": null
  },
  {
    "id": "PLACE-SEARCH-003",
    "description": "All params blank",
    "method": "GET",
    "endpoint": "/api/places/search/",
