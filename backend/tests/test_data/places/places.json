    "method": "GET",
    "endpoint": "/api/places/search/",
    "headers": {"Authorization": "Bearer {token_a}"},
    "payload": null,
    "query_params": {"state": "NJ", "county": "Essex", "city": "Newark", "address": "12 Main St"},
