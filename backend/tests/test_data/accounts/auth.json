  {
    "id": "AUTH-LOGIN-006",
    "description": "Password login is rejected when SSO is enabled",
    "method": "POST",
    "endpoint": "/api/auth/login/",
    "headers": {},
    "payload": {
      "email": "user-a@example.com",
      "password": "{password}"
    },
    "query_params": {},
