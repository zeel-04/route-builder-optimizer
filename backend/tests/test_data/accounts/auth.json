      "SSO_ENABLED": true
    },
    "expected_status": 400,
    "expected_body": {
      "message": "Password sign-in is disabled. Use single sign-on."
    }
  },
  {
    "id": "AUTH-SSO-001",
    "description": "SSO login succeeds for a provisioned user",
    "method": "POST",
    "endpoint": "/api/auth/sso/",
    "headers": {},
    "payload": {
      "id_token": "user-a@example.com"
    },
    "query_params": {},
    "settings": {
      "SSO_ENABLED": true
    },
    "expected_status": 200,
    "expected_body": {
      "user": {
        "email": "user-a@example.com",
        "name": "User A"
      }
    }
  },
  {
    "id": "AUTH-SSO-002",
    "description": "SSO endpoint is rejected when the flag is off",
