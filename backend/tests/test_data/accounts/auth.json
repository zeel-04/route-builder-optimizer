[
  {
    "id": "AUTH-LOGIN-001",
    "description": "Login with valid credentials",
    "method": "POST",
    "endpoint": "/api/auth/login/",
    "headers": {},
    "payload": {"email": "user-a@example.com", "password": "{password}"},
    "query_params": {},
    "expected_status": 200,
    "expected_body": {"user": {"email": "user-a@example.com", "name": "User A"}}
  },
  {
    "id": "AUTH-LOGIN-002",
    "description": "Login with wrong password",
    "method": "POST",
    "endpoint": "/api/auth/login/",
    "headers": {},
    "payload": {"email": "user-a@example.com", "password": "wrong-password"},
    "query_params": {},
    "expected_status": 400,
    "expected_body": {"message": "Invalid email or password."}
  },
  {
    "id": "AUTH-LOGIN-003",
    "description": "Login with missing password field",
    "method": "POST",
    "endpoint": "/api/auth/login/",
    "headers": {},
    "payload": {"email": "user-a@example.com"},
    "query_params": {},
    "expected_status": 400,
    "expected_body": {"message": "Validation error"}
  },
  {
    "id": "AUTH-LOGIN-004",
    "description": "A user without a tenant (superuser) can't sign in",
    "method": "POST",
    "endpoint": "/api/auth/login/",
    "headers": {},
    "payload": {"email": "{admin_email}", "password": "{password}"},
    "query_params": {},
    "expected_status": 400,
    "expected_body": {"message": "Invalid email or password."}
  },
  {
    "id": "AUTH-LOGIN-005",
    "description": "Login email is case-insensitive",
    "method": "POST",
    "endpoint": "/api/auth/login/",
    "headers": {},
    "payload": {"email": "User-A@Example.com", "password": "{password}"},
    "query_params": {},
    "expected_status": 200,
    "expected_body": {"user": {"email": "user-a@example.com"}}
  },
  {
    "id": "AUTH-LOGOUT-001",
    "description": "Logout with a valid token",
    "method": "POST",
    "endpoint": "/api/auth/logout/",
    "headers": {"Authorization": "Bearer {token_a2}"},
    "payload": null,
    "query_params": {},
    "expected_status": 204,
    "expected_body": null
  },
  {
    "id": "AUTH-LOGOUT-002",
    "description": "Logout without a token",
    "method": "POST",
    "endpoint": "/api/auth/logout/",
    "headers": {},
    "payload": null,
    "query_params": {},
    "expected_status": 401,
    "expected_body": null
  },
  {
    "id": "AUTH-ME-001",
    "description": "Get the signed-in user",
    "method": "GET",
    "endpoint": "/api/auth/me/",
    "headers": {"Authorization": "Bearer {token_a}"},
    "payload": null,
    "query_params": {},
    "expected_status": 200,
    "expected_body": {"email": "user-a@example.com"}
  },
  {
    "id": "AUTH-ME-002",
    "description": "Get the signed-in user without a token",
    "method": "GET",
    "endpoint": "/api/auth/me/",
    "headers": {},
    "payload": null,
    "query_params": {},
    "expected_status": 401,
    "expected_body": null
  }
